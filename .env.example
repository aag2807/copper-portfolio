# Copy to .env and fill in. .env is gitignored.

# Get one from https://resend.com/api-keys (free tier: 100/day, 3000/month)
RESEND_API_KEY=

# Resend's built-in test sender works until you verify a domain.
# Once you verify one, switch to e.g. "hello@yourdomain.dev".
RESEND_FROM=onboarding@resend.dev

# Where the contact form delivers to.
RESEND_TO=aagn2807@gmail.com

# Used to sign CSRF tokens (HMAC-SHA256). 64 hex chars recommended.
# If unset, the server generates an ephemeral one at startup and warns to stderr.
# Generate locally with:    openssl rand -hex 32
CSRF_SECRET=
