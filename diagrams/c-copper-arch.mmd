flowchart TD
  accTitle: c-copper request lifecycle
  accDescr: A request is accepted, handed to a pthread, parsed, passed through the logging, static, rate-limit and CSRF middleware, routed to a controller, rendered through the view engine into the layout, and written back to the socket.
  client([client]) --> acc["accept()"]
  acc --> thr["pthread dispatch"]
  thr --> parser["request parser"]
  parser --> chain

  subgraph chain["middleware chain (linked list)"]
    direction LR
    log["logging"] --> stat["static/*"]
    stat --> rate["rate-limit"]
    rate --> csrf["csrf"]
  end

  stat -.->|"/static/app.css"| pub["public/ file"]
  chain --> router["router — strcmp / {param} bind"]
  router --> ctrl["controller ACTION"]
  ctrl --> view["view engine — 2-pass render"]
  view --> layout["layout.html body slot"]
  layout --> flush["response_flush() → write()"]
