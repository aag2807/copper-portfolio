flowchart TD
  accTitle: On-prem LLM gateway architecture
  accDescr: Internal apps call a .NET gateway inside the on-prem boundary. The gateway handles auth, audit and quotas, routes to local model providers, runs a RAG pipeline (chunk, embed, vector search, prompt assembly) and a bounded, logged agent orchestrator. No egress to public AI endpoints.
  apps["internal apps"] --> gw

  subgraph boundary["on-prem boundary — egress to public AI endpoints: none"]
    gw["gateway API (C#/.NET)"] --> auth["auth / audit / quotas"]
    gw --> router["model router"]
    router --> provA["provider A (local)"]
    router --> provB["provider B (local)"]
    gw --> rag

    subgraph rag["RAG pipeline"]
      direction LR
      chunk["chunk"] --> embed["embed"]
      embed --> vec["vector search"]
      vec --> prompt["prompt assembly"]
    end

    rag --> model["model"]
    gw --> agents["agent orchestrator — multi-step, bounded, fully logged"]
  end
